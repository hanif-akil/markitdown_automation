# ==============================================================================
# MARKITDOWN AUTOMATION SCRIPT CONFIGURATION (.env)
# ==============================================================================

# Option A: Local Ollama (Fully Offline, Free, No API Key Required)
# 1. Install Ollama from https://ollama.com
# 2. Run in terminal: ollama run llama3.2-vision
# 3. Remove the "#" to uncomment the lines below:
# OPENAI_BASE_URL=http://localhost:11434/v1/
# OPENAI_MODEL=llama3.2-vision

# Option B: Google Gemini API (High-quality cloud OCR)
# 1. Get a free API key from https://aistudio.google.com/
# 2. Set your key below (remove the '#' to uncomment):
# GEMINI_API_KEY=your_gemini_api_key_here

# Option C: OpenAI API (Alternative cloud OCR)
# 1. Get an API key from https://platform.openai.com/
# 2. Set your key below (remove the '#' to uncomment):
# OPENAI_API_KEY=your_openai_api_key_here
